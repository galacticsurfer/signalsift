# AWS
SIGNALSIFT_AWS_PROFILE=default
SIGNALSIFT_AWS_REGION=ap-south-1

# Comma-separated allowlist of CloudWatch log groups SignalSift may query.
# Empty list = every query is rejected.
SIGNALSIFT_ALLOWED_LOG_GROUPS=/aws/app/payments-prod,/aws/app/orders-prod

# Query guardrails
SIGNALSIFT_MAX_TIME_RANGE_MINUTES=120
SIGNALSIFT_MAX_QUERY_RESULTS=5000

# Local LLM (Ollama)
SIGNALSIFT_OLLAMA_URL=http://localhost:11434
SIGNALSIFT_LLM_MODEL=qwen3.5:4b-mlx
SIGNALSIFT_LLM_TIMEOUT_SECONDS=120
SIGNALSIFT_MAX_LLM_INPUT_CHARS=40000

# MCP output guardrail
SIGNALSIFT_MAX_MCP_RESPONSE_CHARS=12000

# Cache
SIGNALSIFT_CACHE_PATH=~/.signalsift/cache.sqlite3
SIGNALSIFT_CACHE_TTL_SECONDS=900

# Redaction of PII (secrets are ALWAYS redacted; these toggle optional PII rules)
SIGNALSIFT_REDACT_EMAILS=true
SIGNALSIFT_REDACT_PHONE_NUMBERS=false
SIGNALSIFT_REDACT_IP_ADDRESSES=false

# Logging
SIGNALSIFT_LOG_LEVEL=INFO
SIGNALSIFT_DEBUG=false
